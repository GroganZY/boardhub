{
  "version": 2,
  "stale_days": 7,
  "routes": {
    "gemini": {
      "adapter": "gemini_agy",
      "enabled": false,
      "conversation_id": null,
      "agy_client_path": "/absolute/path/to/agy_client.py"
    },
    "codex": {
      "adapter": "codex",
      "enabled": false,
      "mode": "spawn",
      "sandbox": "workspace-write",
      "resume_same_thread": true,
      "max_concurrency": 1
    },
    "dsh": {
      "adapter": "dsh",
      "enabled": false,
      "mode": "spawn",
      "resume_same_thread": true
    },
    "claude_main": {
      "adapter": "claude",
      "enabled": false,
      "session_id": null,
      "claude_bin": "/absolute/path/to/claude"
    },
    "claude_side": {
      "adapter": "claude",
      "enabled": false,
      "session_id": null,
      "claude_bin": "/absolute/path/to/claude"
    }
  },
  "mail": {
    "enabled": false,
    "notifier_path": "/absolute/path/to/notify_mail.py"
  }
}
