<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.boardhub-watch</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>-I</string>
        <string>__BOARDHUB_RUNTIME_DIR__/board_watch.py</string>
        <string>--board</string>
        <string>__BOARDHUB_BOARD_DIR__</string>
        <string>--runtime-dir</string>
        <string>__BOARDHUB_RUNTIME_DIR__</string>
        <string>--human</string>
        <string>__BOARDHUB_HUMAN__</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>Umask</key>
    <integer>63</integer>
</dict>
</plist>
